// Prisma schema for Campus Complaint and Feedback Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COORDINATOR
  DEPARTMENT
  ADMIN
}

enum ComplaintStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(STUDENT)
  contactNumber String?
  classId       String?
  departmentId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Student belongs to a Class
  class            Class?            @relation("ClassStudents", fields: [classId], references: [id])

  // Coordinator manages Classes (one-to-many: a coordinator can manage multiple classes)
  managedClasses   Class[]           @relation("ClassCoordinator")

  // Department user belongs to a Department
  department       Department?       @relation("DepartmentUsers", fields: [departmentId], references: [id])

  // Complaints created by this student
  complaints       Complaint[]

  // Feedback submitted by this student
  feedbacks        Feedback[]

  // Complaint updates created by this user
  complaintUpdates ComplaintUpdate[]

  // Audit logs where this user was the actor
  auditLogsAsActor AuditLog[]        @relation("AuditActor")

  // Audit logs where this user was the target
  auditLogsAsTarget AuditLog[]       @relation("AuditTarget")

  @@index([classId])
  @@index([departmentId])
}

model Class {
  id          String   @id @default(uuid())
  className   String   @unique
  department  String?
  coordinatorId String?
  createdAt   DateTime @default(now())

  // Coordinator assigned to this class
  coordinator   User?    @relation("ClassCoordinator", fields: [coordinatorId], references: [id])

  // Students in this class
  students      User[]    @relation("ClassStudents")

  // Complaints belonging to this class
  complaints    Complaint[]

  @@index([coordinatorId])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // Complaints assigned to this department
  complaints Complaint[]

  // Users belonging to this department
  users      User[]  @relation("DepartmentUsers")
}

model Complaint {
  id               String          @id @default(uuid())
  studentId        String
  classId          String
  title            String
  category         String
  description      String
  location         String?
  attachmentUrl    String?
  priority         Priority        @default(MEDIUM)
  status           ComplaintStatus @default(PENDING_VERIFICATION)
  coordinatorRemark String?
  rejectionReason  String?
  departmentId     String?
  adminRemark      String?
  assignedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resolvedAt       DateTime?

  // Relations
  student          User            @relation(fields: [studentId], references: [id])
  class            Class           @relation(fields: [classId], references: [id])
  department       Department?     @relation(fields: [departmentId], references: [id])

  // Feedback for this complaint (one-to-one)
  feedback         Feedback?

  // Progress history
  updates          ComplaintUpdate[]

  @@index([studentId])
  @@index([classId])
  @@index([departmentId])
  @@index([status])
}

model Feedback {
  id         String   @id @default(uuid())
  complaintId String  @unique
  studentId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  // Relations
  complaint  Complaint @relation(fields: [complaintId], references: [id])
  student    User      @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model ComplaintUpdate {
  id          String          @id @default(uuid())
  complaintId String
  userId      String?
  status      ComplaintStatus
  message     String
  createdAt   DateTime        @default(now())

  // Relations
  complaint   Complaint       @relation(fields: [complaintId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])

  @@index([complaintId])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String
  targetUserId  String?
  action        String
  oldRole       String?
  newRole       String?
  details       String?
  createdAt     DateTime @default(now())

  // Relations
  actor         User     @relation("AuditActor", fields: [actorUserId], references: [id])
  target        User?    @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([actorUserId])
  @@index([targetUserId])
}
